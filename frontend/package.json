{
  "name": "silversky-web",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "node tests/e2e.mjs",
    "test:v2": "node tests/v2-live.mjs",
    "test:v2-failures": "node tests/v2-failures.mjs",
    "test:amap-local": "node tests/amap-local-check.mjs",
    "test:scene-fallback": "node tests/scene-fallback.mjs",
    "test:scene-performance": "node tests/scene-performance.mjs",
    "test:a11y": "node tests/accessibility.mjs",
    "test:zoom-200": "node tests/zoom-200.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "1.0.1",
    "cesium": "^1.132.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@remotion/cli": "4.0.529",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.63.0",
    "remotion": "4.0.529",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-cesium": "^1.2.23",
    "vitest": "^3.2.4"
  }
}
