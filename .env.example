# Local only. Copy to .env after confirming each Key's platform type in AMap Console.
# The Vite development server reads these values from the project root.
AMAP_WEB_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_WEB_SERVICE_KEY=
# V2: server only; existing process environment takes precedence over .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
